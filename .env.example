# Server
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edugenai

# Local AI - Ollama
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_GENERATION_MODEL=llama3.1

# Frontend
VITE_API_BASE_URL=http://localhost:3001

# RAG Settings
MAX_CHUNKS_FOR_DEMO=50
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5
